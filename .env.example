# Server Configuration
PORT=5001
JWT_SECRET=mab_battery_counter_jwt_secret_2026_change_in_production

# Persistent storage (set these on Render/Railway/VPS with a mounted disk)
# DATA_DIR=/var/data
# DB_PATH=/var/data/mab_battery.sqlite
# BACKUP_DIR=/var/data/backups

# WhatsApp Cloud API (Meta Graph API)
# Primary messaging channel for invoice summaries, payment receipts & due reminders
# Create at https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Twilio SMS (Fallback)
# https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Fast2SMS (Indian SMS Fallback)
# https://www.fast2sms.com/
FAST2SMS_API_KEY=

# NOTE: If all API keys are left empty, the app seamlessly falls back to 
# opening pre-filled WhatsApp links (https://wa.me/91...) with zero paid API costs!
