{
  "name": "maharashtra-auto-battery",
  "version": "1.0.0",
  "description": "Counter Billing & Inventory PWA Web App for Maharashtra Auto Battery",
  "main": "server/server.js",
  "scripts": {
    "start": "node --experimental-sqlite server/server.js",
    "postinstall": "npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev:server": "node --experimental-sqlite server/server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "node --experimental-sqlite server/server.js",
    "test": "node --experimental-sqlite test_api.js"
  },
  "keywords": [
    "billing",
    "battery-shop",
    "pwa",
    "pos",
    "inventory"
  ],
  "author": "Maharashtra Auto Battery",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
